<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fabrizio.App.LoginChoicePage"
             Title="Sign In">

	<!-- UI goes here -->



<VerticalStackLayout Padding="24" Spacing="16">
		<Label Text="Choose how to sign in" FontSize="18" HorizontalOptions="Center" />
		<Button Text="Sign in with e-mail" Clicked="OnEmailLoginClicked" />
		<Button Text="Sign in with Google (coming soon)" IsEnabled="False" />
	</VerticalStackLayout>
</ContentPage>
