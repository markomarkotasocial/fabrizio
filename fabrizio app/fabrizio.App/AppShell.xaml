<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:tabs="clr-namespace:fabrizio.App.Pages.Tabs"
    xmlns:auth="clr-namespace:fabrizio.App.Pages.Auth"
    xmlns:flows="clr-namespace:fabrizio.App.Pages.Flows"
    x:Class="fabrizio.App.AppShell">


	<!-- Bottom Tab Bar -->
	<TabBar>
		<ShellContent Title="Home"
                      Icon="home.png"
                      ContentTemplate="{DataTemplate tabs:HomePage}"
					  Route="home"/>

		<ShellContent Title="Trips"
                      Icon="trips.png"
                      ContentTemplate="{DataTemplate tabs:TripsPage}" 
					  Route="trips"/>

		<ShellContent Title="Add"
                      Icon="add.png"
                      ContentTemplate="{DataTemplate tabs:AddPage}"
					  Route="add"/>

		<ShellContent Title="Discover"
                      Icon="discover.png"
                      ContentTemplate="{DataTemplate tabs:DiscoverPage}"
					  Route="discover"/>

		<ShellContent Title="Profile"
					  Icon="profile.png"
					  ContentTemplate="{DataTemplate tabs:ProfilePage}" 
					  Route="profile"/>
	</TabBar>

</Shell>
