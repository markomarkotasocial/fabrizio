<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="fabrizio.App.Pages.Tabs.ProfilePage"
			 Shell.NavBarIsVisible="False"
			 BackgroundColor="#101922">

	<Grid Padding="20">

		<!-- ### CONTENT ### -->
		<ScrollView IsVisible="{Binding HasAccount}">
			<VerticalStackLayout Spacing="18">

				<!-- HEADER TITLE -->
				<Grid ColumnDefinitions="*,Auto" Padding="0,4">
					<Label Text="Profile"
						   FontSize="26"
						   FontAttributes="Bold"
						   TextColor="White" />

					<Frame Grid.Column="1"
						   WidthRequest="40"
						   HeightRequest="40"
						   CornerRadius="20"
						   BackgroundColor="#1E293B"
						   BorderColor="#334155"
						   HasShadow="False"
						   Padding="0">
						
						<Image Source="notifications.png"
							   WidthRequest="20"
							   HeightRequest="20"
							   HorizontalOptions="Center"
							   VerticalOptions="Center">

							<Image.Behaviors>
								<toolkit:IconTintColorBehavior TintColor="#94A3B8"/>
							</Image.Behaviors>

						</Image>

					</Frame>
				</Grid>

				<!-- PROFILE CARD -->
				<Frame CornerRadius="24"
					   Padding="16"
					   BackgroundColor="#1E293B"
					   BorderColor="#334155"
					   HasShadow="False">

					<HorizontalStackLayout Spacing="14">

						<!-- AVATAR -->
						<Grid WidthRequest="64" HeightRequest="64">
							<Frame CornerRadius="18"
								   BackgroundColor="#6366F1"
								   Padding="0"
								   HasShadow="False">
								<Label Text="MM"
									   HorizontalOptions="Center"
									   VerticalOptions="Center"
									   FontAttributes="Bold"
									   FontSize="20"
									   TextColor="White"/>
							</Frame>

							<Frame WidthRequest="18"
								   HeightRequest="18"
								   CornerRadius="9"
								   BackgroundColor="#22C55E"
								   BorderColor="#1E293B"
								   HorizontalOptions="End"
								   VerticalOptions="End"
								   Padding="0"
								   HasShadow="False"/>
						</Grid>

						<!-- NAME + EMAIL -->
						<VerticalStackLayout Spacing="2" Margin="15">

							<Grid>
								<!-- VIEW -->
								<Label Text="{Binding Name}"
									   FontSize="18"
									   FontAttributes="Bold"
									   TextColor="White"
									   IsVisible="{Binding IsNotEditingName}">
									<Label.GestureRecognizers>
										<TapGestureRecognizer Tapped="OnNameTapped"/>
									</Label.GestureRecognizers>
								</Label>

								<!-- EDIT -->
								<Entry Text="{Binding Name}"
									   FontSize="18"
									   FontAttributes="Bold"
									   TextColor="White"
									   BackgroundColor="Transparent"
									   IsVisible="{Binding IsEditingName}"
									   Completed="OnNameCompleted"
									   Unfocused="OnNameUnfocused"/>
							</Grid>

							<Label Text="{Binding Account.Email}"
								   FontSize="12"
								   TextColor="#94A3B8"/>
						</VerticalStackLayout>

						<!-- EDIT ICON -->
						<Image Source="edit2.png"
							   WidthRequest="22"
							   HeightRequest="22"
							   VerticalOptions="Center">
							
							<Image.Behaviors>
								<toolkit:IconTintColorBehavior TintColor="#94A3B8"/>
							</Image.Behaviors>

						</Image>

					</HorizontalStackLayout>
				</Frame>

				<!-- TRAVEL ACHIEVEMENTS -->
				<VerticalStackLayout Spacing="10">

					<Grid ColumnDefinitions="*,Auto">
						<Label Text="TRAVEL ACHIEVEMENTS"
							   FontSize="12"
							   FontAttributes="Bold"
							   TextColor="#94A3B8"/>

						<Frame Grid.Column="1"
							   Padding="8,2"
							   CornerRadius="10"
							   BackgroundColor="#1E293B"
							   BorderColor="#1E293B"
							   HasShadow="False">
							<Label Text="Elite Member"
								   FontSize="10"
								   TextColor="#6366F1"
								   FontAttributes="Bold"/>
						</Frame>
					</Grid>

					<Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

						<!-- Trips -->
						<Frame Grid.Column="0"
							   CornerRadius="20"
							   BackgroundColor="#1E293B"
							   BorderColor="#334155"
							   HasShadow="False"
							   Padding="14">
							<VerticalStackLayout Spacing="2" 
												 HorizontalOptions="Center">
								<Label Text="7"
									   FontSize="22"
									   FontAttributes="Bold"
									   TextColor="#6366F1"
									   HorizontalOptions="Center"/>
								<Label Text="TRIPS&#10;COMPLETED"
									   FontSize="10"
									   HorizontalTextAlignment="Center"
									   TextColor="#94A3B8"
									   FontAttributes="Bold"/>
							</VerticalStackLayout>
						</Frame>

						<!-- Cities -->
						<Frame Grid.Column="1"
							   CornerRadius="20"
							   BackgroundColor="#1E293B"
							   BorderColor="#334155"
							   HasShadow="False"
							   Padding="14">
							<VerticalStackLayout Spacing="2" HorizontalOptions="Center">
								<Label Text="12"
									   FontSize="22"
									   FontAttributes="Bold"
									   TextColor="#6366F1"
									   HorizontalOptions="Center"/>
								<Label Text="CITIES&#10;VISITED"
									   FontSize="10"
									   HorizontalTextAlignment="Center"
									   TextColor="#94A3B8"
                               FontAttributes="Bold"/>
							</VerticalStackLayout>
						</Frame>

						<!-- Countries -->
						<Frame Grid.Column="2"
							   CornerRadius="20"
							   BackgroundColor="#1E293B"
							   BorderColor="#334155"
							   HasShadow="False"
							   Padding="14">
							<VerticalStackLayout Spacing="2" HorizontalOptions="Center">
								<Label Text="3"
									   FontSize="22"
									   FontAttributes="Bold"
									   TextColor="#6366F1"
									   HorizontalOptions="Center"/>
								<Label Text="COUNTRIES&#10;EXPLORED"
									   FontSize="10"
									   HorizontalTextAlignment="Center"
									   TextColor="#94A3B8"
									   FontAttributes="Bold"/>
							</VerticalStackLayout>
						</Frame>

					</Grid>
				</VerticalStackLayout>

				<!-- ACCOUNT DETAILS -->
				<VerticalStackLayout Spacing="6">
					<Label Text="ACCOUNT DETAILS"
						   FontSize="12"
						   FontAttributes="Bold"
						   TextColor="#94A3B8"/>

					<Frame CornerRadius="20"
						   BackgroundColor="#1E293B"
						   BorderColor="#334155"
						   HasShadow="False"
						   Padding="16">

						<Grid ColumnDefinitions="Auto,*,Auto" 
							  ColumnSpacing="12">
							
							<Image
								Source="location.svg"
								WidthRequest="18"
								HeightRequest="18"
								VerticalOptions="Center">
								<Image.Behaviors>
									<toolkit:IconTintColorBehavior TintColor="#94A3B8"/>
								</Image.Behaviors>

							</Image>

							<Label Grid.Column="1"
								   Text="Home Location"
								   TextColor="White"/>
							<Label Grid.Column="2"
								   Text="Zagreb"
								   TextColor="#94A3B8"/>
						</Grid>
					</Frame>
				</VerticalStackLayout>

				<!-- APP SETTINGS -->
				<VerticalStackLayout Spacing="6">
					<Label Text="APP SETTINGS"    
						   FontSize="12"
						   FontAttributes="Bold"
						   TextColor="#94A3B8"/>

					<Frame CornerRadius="20"
						   BackgroundColor="#1E293B"
						   BorderColor="#334155"
						   HasShadow="False"
						   Padding="0">

						<VerticalStackLayout Spacing="0">

							<!-- Language -->
							<Grid Padding="16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

								<Grid.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding EditLanguageCommand}" />
								</Grid.GestureRecognizers>

								<Image Source="globe.svg"
									   WidthRequest="18"
									   HeightRequest="18"
									   VerticalOptions="Center">
									<Image.Behaviors>
										<toolkit:IconTintColorBehavior TintColor="#94A3B8"/>
									</Image.Behaviors>

								</Image>


								<Label Grid.Column="1"
									   Text="Preferred language"
									   VerticalOptions="Center"
									   TextColor="White"/>

								<Label Grid.Column="2"
									   Text="{Binding PreferredLanguageDisplay}"
									   VerticalOptions="Center"
									   TextColor="#94A3B8"/>

							</Grid>

							<BoxView HeightRequest="1" Color="#334155"/>

							<!-- Currency -->
							<Grid Padding="16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

								<Grid.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding EditCurrencyCommand}" />
								</Grid.GestureRecognizers>

								<Image Source="payments.svg"
									   WidthRequest="18"
									   HeightRequest="18"
									   VerticalOptions="Center">
									<Image.Behaviors>
										<toolkit:IconTintColorBehavior TintColor="#94A3B8"/>
									</Image.Behaviors>

								</Image>


								<Label Grid.Column="1"
									   Text="Preferred currency"
									   VerticalOptions="Center"
									   TextColor="White"/>

								<Label Grid.Column="2"
									   Text="{Binding PreferredCurrencyDisplay}"
									   VerticalOptions="Center"
									   TextColor="#94A3B8"/>

							</Grid>

							<BoxView HeightRequest="1" Color="#334155"/>

							<!-- Time zone -->
							<Grid Padding="16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

								<Grid.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding EditTimeZoneCommand}" />
								</Grid.GestureRecognizers>

								<Image Source="time_zone.svg"
									   WidthRequest="18"
									   HeightRequest="18"
									   VerticalOptions="Center">
									<Image.Behaviors>
										<toolkit:IconTintColorBehavior TintColor="#94A3B8"/>
									</Image.Behaviors>

								</Image>


								<Label Grid.Column="1"
									   Text="Default time zone"
									   VerticalOptions="Center"
									   TextColor="White"/>

								<Label Grid.Column="2"
									   Text="{Binding TimeZoneDisplay}"
									   VerticalOptions="Center"
									   TextColor="#94A3B8"/>

							</Grid>

							<BoxView HeightRequest="1" Color="#334155"/>

							<!-- Dark mode -->
							<Grid Padding="16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52">

								<Image Source="dark_mode.svg"
									   WidthRequest="18"
									   HeightRequest="18"
									   VerticalOptions="Center">
									<Image.Behaviors>
										<toolkit:IconTintColorBehavior TintColor="#94A3B8"/>
									</Image.Behaviors>

								</Image>


								<Label Grid.Column="1"
									   Text="Dark mode"
									   VerticalOptions="Center"
									   TextColor="White"/>

								<Switch Grid.Column="2"
										VerticalOptions="Center"
										IsEnabled="False"
										IsToggled="{Binding Account.IsDarkMode}"/>

							</Grid>

						</VerticalStackLayout>

					</Frame>

				</VerticalStackLayout>

				<!-- MANAGE ACCOUNT -->
				<VerticalStackLayout Spacing="6" Padding="0,0,0,30">

					<Label Text="MANAGE ACCOUNT"
						   FontSize="12"
						   FontAttributes="Bold"
						   TextColor="#94A3B8"/>

					<Frame CornerRadius="20"
						   BackgroundColor="#1E293B"
						   BorderColor="#334155"
						   HasShadow="False"
						   Padding="0">

						<VerticalStackLayout Spacing="0">

							<!-- Delete account -->
							<Grid Padding="16"
								  ColumnDefinitions="Auto,*"
								  ColumnSpacing="12">

								<Grid.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
								</Grid.GestureRecognizers>

								<Image Source="delete_account.svg"
									   WidthRequest="18"
									   HeightRequest="18"
									   VerticalOptions="Center">
									<Image.Behaviors>
										<toolkit:IconTintColorBehavior TintColor="#FB7185"/>
									</Image.Behaviors>

								</Image>


								<Label Grid.Column="1"
									   Text="Delete account"
									   VerticalOptions="Center"
									   TextColor="#FB7185"
									   FontAttributes="Bold"/>

							</Grid>

							<BoxView HeightRequest="1" Color="#334155"/>

							<!-- Sign out -->
							<Grid Padding="16"
								  ColumnDefinitions="Auto,*"
								  ColumnSpacing="12">

								<Grid.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding LogoutCommand}" />
								</Grid.GestureRecognizers>

								<Image Source="logout.svg"
									   WidthRequest="18"
									   HeightRequest="18"
									   VerticalOptions="Center">
									<Image.Behaviors>
										<toolkit:IconTintColorBehavior TintColor="#94A3B8"/>
									</Image.Behaviors>

								</Image>


								<Label Grid.Column="1"
									   Text="Sign out"
									   VerticalOptions="Center"
									   TextColor="White"
									   FontAttributes="Bold"/>

							</Grid>

						</VerticalStackLayout>

					</Frame>

				</VerticalStackLayout>

			</VerticalStackLayout>
		</ScrollView>


		<!-- ### EMPTY STATE ### -->
		<StackLayout
			IsVisible="{Binding IsEmpty}"
			HorizontalOptions="Center"
			VerticalOptions="Center">
			<Label Text="" />
		</StackLayout>


		<!-- ### INITIAL LOADING ### -->
		<ActivityIndicator
			IsRunning="{Binding IsBusy}"
			IsVisible="{Binding IsBusy}"
			HorizontalOptions="Center"
			VerticalOptions="Center"/>

	</Grid>

</ContentPage>
