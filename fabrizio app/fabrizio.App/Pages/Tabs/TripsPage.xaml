<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fabrizio.App.Pages.Tabs.TripsPage"
			 Shell.NavBarIsVisible="False"
			 BackgroundColor="#101922">

	<Grid Padding="20" 
		  RowDefinitions="Auto,*">

		<!-- HEADER -->
		<VerticalStackLayout Grid.Row="0" Spacing="12">

			<Grid ColumnDefinitions="*,Auto">

				<Label
					Text="My Trips"
					FontSize="28"
					FontAttributes="Bold"
					TextColor="White"
					VerticalOptions="Center" />

				<!-- search placeholder -->
				<Frame
					Grid.Column="1"
					WidthRequest="40"
					HeightRequest="40"
					CornerRadius="20"
					BackgroundColor="#1A222C"
					BorderColor="#2A3646"
					Padding="0"
					HasShadow="False">
					
					<Label
						Text="🔍"
						HorizontalOptions="Center"
						VerticalOptions="Center" />
				</Frame>

			</Grid>

			<!-- FILTER CHIPS (UI only za sada) -->
			<CollectionView
				SelectionMode="None"
				HeightRequest="34"
				Margin="0,0,0,12">

				<CollectionView.ItemsSource>
					<x:Array Type="{x:Type x:String}">
						<x:String>All</x:String>
						<x:String>Upcoming</x:String>
						<x:String>Past</x:String>
					</x:Array>
				</CollectionView.ItemsSource>

				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Horizontal" />
				</CollectionView.ItemsLayout>

				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Frame
							Padding="12,8"
							Margin="0,0,6,0"
							CornerRadius="18"
							BackgroundColor="#1A222C"
							BorderColor="#2A3646"
							HasShadow="False">

							<Label
								Text="{Binding .}"
								FontSize="12"
								TextColor="#9FB3C8"
								FontAttributes="Bold" />
						</Frame>
					</DataTemplate>
				</CollectionView.ItemTemplate>

			</CollectionView>

		</VerticalStackLayout>


		<!-- CONTENT -->
		<RefreshView
			Grid.Row="1"
			IsRefreshing="{Binding IsRefreshing}"
			Command="{Binding RefreshCommand}">

			<CollectionView
				ItemsSource="{Binding Trips}"
				SelectedItem="{Binding SelectedTrip}"
				SelectionMode="Single"				
				Margin="0,10,0,80">

				<CollectionView.ItemTemplate>
					<DataTemplate>

						<!-- TRIP CARD -->
						<Frame
							CornerRadius="18"
							Margin="0,0,0,14"
							Padding="16"
							BackgroundColor="#121A23"
							BorderColor="#2A3646"
							HasShadow="False"
							HeightRequest="150">

							<VerticalStackLayout Spacing="10">

								<!-- NAME + BADGE -->
								<Grid ColumnDefinitions="*,Auto">

									<Label
                                    Text="{Binding Name}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    LineBreakMode="TailTruncation" />

									<!-- NOW badge placeholder -->
									<Frame
										Grid.Column="1"
										Padding="8,2"
										CornerRadius="10"
										BackgroundColor="#137fec33"
										BorderColor="#137fec"
										HasShadow="False"
										IsVisible="{Binding IsCurrent}">

										<Label
											Text="NOW"
											FontSize="10"
											TextColor="#137fec"
											FontAttributes="Bold" />
									</Frame>

								</Grid>

								<!-- DATE -->
								<Label
									Text="{Binding DateRangeText}"
									FontSize="12"
									TextColor="#9FB3C8"
									 />

								<!-- DESTINATIONS -->
								<CollectionView
									ItemsSource="{Binding Current.Destinations}"
									ItemsLayout="HorizontalList"
									HeightRequest="34"
									SelectionMode="None">

									<CollectionView.ItemTemplate>
										<DataTemplate>
											<Frame
                                            Padding="10,4"
                                            Margin="0,0,8,0"
                                            CornerRadius="16"
                                            BackgroundColor="#FFFFFF14"
                                            BorderColor="#FFFFFF22"
                                            HasShadow="False">

												<Label
                                                Text="{Binding Name}"
                                                FontSize="11"
                                                TextColor="White" />
											</Frame>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>

								<!-- DAYS LEFT -->
								<Grid ColumnDefinitions="*,Auto">

									<Grid />

									<VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="0"
                                    IsVisible="{Binding ShowCountdown}">

										<Label
											Text="{Binding DaysLeft}"
											FontSize="18"
											FontAttributes="Bold"
											TextColor="#137fec"
											HorizontalOptions="End" />

										<Label
											Text="Days Left"
											FontSize="9"
											TextColor="#9FB3C8"
											HorizontalOptions="End" />

									</VerticalStackLayout>

								</Grid>

							</VerticalStackLayout>

						</Frame>

					</DataTemplate>
				</CollectionView.ItemTemplate>

			</CollectionView>

		</RefreshView>


		<!-- EMPTY -->
		<StackLayout
			IsVisible="{Binding IsEmpty}"
			HorizontalOptions="Center"
			VerticalOptions="Center">
			
		</StackLayout>

		<!-- LOADING -->
		<ActivityIndicator
			IsRunning="{Binding IsBusy}"
			IsVisible="{Binding IsBusy}"
			HorizontalOptions="Center"
			VerticalOptions="Center"/>

		<!-- FAB -->
		<Button
			Grid.RowSpan="2"
			Text="+"
			Command="{Binding AddTripCommand}"
			BackgroundColor="#FF7D54"
			TextColor="White"
			FontSize="32"
			WidthRequest="64"
			HeightRequest="64"
			CornerRadius="32"
			VerticalOptions="End"
			HorizontalOptions="End"
			Margin="0,0,6,24"
			ZIndex="10" />
	</Grid>


</ContentPage>
	
	
	
	
	
	
