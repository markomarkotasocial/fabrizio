<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="fabrizio.App.Pages.Tabs.TripsPage"
			 Shell.NavBarIsVisible="False"
			 BackgroundColor="#101922">

	<Grid Padding="20" 
		  RowDefinitions="Auto,*">

		<!-- HEADER -->
		<VerticalStackLayout Grid.Row="0" Spacing="12">

			<Grid ColumnDefinitions="*,Auto">

				<Label
					Text="My Trips"
					FontSize="26"
					FontAttributes="Bold"
					TextColor="White"
					VerticalOptions="Center" />

				<!-- search placeholder -->
				<Frame
					Grid.Column="1"
					WidthRequest="40"
					HeightRequest="40"
					CornerRadius="20"
					BackgroundColor="#1A222C"
					BorderColor="#2A3646"
					Padding="0"
					HasShadow="False">
					
					<Label
						Text="🔍"
						HorizontalOptions="Center"
						VerticalOptions="Center" />
				</Frame>

			</Grid>

			<!-- FILTER CHIPS (UI only za sada) -->
			<CollectionView
				ItemsSource="{Binding Filters}"
				SelectionMode="None"
				HeightRequest="34"   
				Margin="0,0,0,12">

				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Horizontal"/>
				</CollectionView.ItemsLayout>

				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Frame
							x:Name="ChipFrame"
							Padding="12,8"
							Margin="0,0,6,0"
							CornerRadius="18"
							BorderColor="#2A3646"
							BackgroundColor="#1B2633"
							HasShadow="False">

							<Frame.GestureRecognizers>
								<TapGestureRecognizer
									Tapped="OnChipTapped"
									Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SetFilterCommand}"
									CommandParameter="{Binding .}" />
							</Frame.GestureRecognizers>

							<Frame.Triggers>
								<DataTrigger
									TargetType="Frame"
									Binding="{Binding IsSelected}"
									Value="True">
									<Setter Property="BackgroundColor" Value="#2E7DFF"/>
									<Setter Property="BorderColor" Value="#2E7DFF"/>
								</DataTrigger>
							</Frame.Triggers>

							<Label
								Text="{Binding Name}"
								FontSize="12"
								TextColor="#9FB3C8"
								FontAttributes="Bold">

								<Label.Triggers>
									<DataTrigger
										TargetType="Label"
										Binding="{Binding IsSelected}"
										Value="True">
										<Setter Property="TextColor" Value="White"/>
									</DataTrigger>
								</Label.Triggers>

							</Label>

						</Frame>
					</DataTemplate>
				</CollectionView.ItemTemplate>

			</CollectionView>

		</VerticalStackLayout>

		<!-- CONTENT -->
		<RefreshView
			Grid.Row="1"
			IsRefreshing="{Binding IsRefreshing}"
			Command="{Binding RefreshCommand}">

			<CollectionView
				ItemsSource="{Binding Trips}"
				Margin="0,10,0,80">

				<CollectionView.ItemTemplate>
					<DataTemplate>

						<!-- TRIP CARD -->
						<Frame
							CornerRadius="18"
							Margin="0,0,0,14"
							Padding="18"
							BackgroundColor="#121A23"
							BorderColor="#2A3646"							
							HasShadow="False"
							HeightRequest="180">

							<Frame.GestureRecognizers>
								<TapGestureRecognizer
									Command="{Binding BindingContext.OpenTripCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
									CommandParameter="{Binding .}" />
							</Frame.GestureRecognizers>

							<!-- 🔥 KLJUČNI GRID -->
							<Grid RowDefinitions="Auto,Auto,*,Auto">

								<!-- NAME + BADGE -->
								<Grid
									Grid.Row="0"
									ColumnDefinitions="*,Auto">

									<Label
										Text="{Binding Name}"
										Margin="0,0,0,4"
										FontSize="18"
										FontAttributes="Bold"
										TextColor="White" />

									<!-- NOW badge -->
									<Frame
										Grid.Column="1"
										Padding="10,8"
										CornerRadius="16"
										BackgroundColor="#137fec33"
										BorderColor="#137fec"
										HasShadow="False"
										IsVisible="{Binding IsCurrent}">

										<Label
											Text="NOW"
											FontSize="10"
											TextColor="#137fec"
											FontAttributes="Bold" />
									</Frame>

								</Grid>

								<!-- DATE -->
								<Label
									Grid.Row="1"
									Text="{Binding DateRangeText}"
									FontSize="12"
									TextColor="#9FB3C8"/>

								<!-- 🔥 SPACER (prazan red koji gura dolje) -->
								<BoxView Grid.Row="2" Opacity="0" />

								<!-- DESTINATIONS + DAYS LEFT (ZAKUCANO NA DNO) -->
								<Grid
									Grid.Row="3"
									ColumnDefinitions="*,Auto"
									VerticalOptions="End">

									<!-- LEFT: DESTINATIONS -->
									<HorizontalStackLayout
										Grid.Column="0"
										Spacing="0"
										VerticalOptions="Center">

										<CollectionView
											ItemsSource="{Binding VisibleDestinations}"
											ItemsLayout="HorizontalList"
											SelectionMode="None"
											HorizontalOptions="Start"
											VerticalOptions="Center">

											<CollectionView.ItemTemplate>
												<DataTemplate>
													<Frame
														Padding="10,8"
														Margin="0,0,6,0"
														CornerRadius="16"
														BackgroundColor="Transparent"
														BorderColor="White"
														HasShadow="False"
														VerticalOptions="Center">

														<Label
															Text="{Binding Name}"
															FontSize="10"
															TextColor="White" />
													</Frame>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>

										<!-- +N CHIP -->
										<Frame
											IsVisible="{Binding HasHiddenDestinations}"
											Padding="10,8"
											CornerRadius="16"
											BackgroundColor="Transparent"
											BorderColor="White"
											HasShadow="False"
											VerticalOptions="Center">

											<Label
												Text="{Binding HiddenDestinationsCount, StringFormat='+{0}'}"
												FontSize="10"
												TextColor="White" />
										</Frame>

									</HorizontalStackLayout>

									<!-- RIGHT: DAYS LEFT -->
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="0"
										IsVisible="{Binding ShowCountdown}"
										HorizontalOptions="End"
										VerticalOptions="Center">

										<Label
											Text="{Binding DaysLeft}"
											FontSize="20"
											FontAttributes="Bold"
											TextColor="#137fec"
											HorizontalOptions="End" />

										<Label
											Text="Days Left"
											FontSize="9"
											TextColor="#9FB3C8"
											HorizontalOptions="End" />

									</VerticalStackLayout>

								</Grid>

							</Grid>

						</Frame>

					</DataTemplate>
				</CollectionView.ItemTemplate>

			</CollectionView>

		</RefreshView>

		<!-- EMPTY -->
		<StackLayout
			IsVisible="{Binding IsEmpty}"
			HorizontalOptions="Center"
			VerticalOptions="Center">
			
		</StackLayout>

		<!-- LOADING -->
		<ActivityIndicator
			IsRunning="{Binding IsBusy}"
			IsVisible="{Binding IsBusy}"
			HorizontalOptions="Center"
			VerticalOptions="Center"/>

		<!-- FAB -->
		<ImageButton
			Grid.RowSpan="2"
			Source="add.svg"
			Command="{Binding AddTripCommand}"
			BackgroundColor="#FF7D54"
			WidthRequest="64"
			HeightRequest="64"
			CornerRadius="32" 
			BorderColor="Black"
			BorderWidth="4"
			Padding="16"
			VerticalOptions="End"
			HorizontalOptions="End"
			Margin="0,0,4,20"
			ZIndex="10">
			<ImageButton.Behaviors>
				<toolkit:IconTintColorBehavior TintColor="White"/>
			</ImageButton.Behaviors>

		</ImageButton>
	</Grid>


</ContentPage>
	
	
	
	
	
	