<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fabrizio.App.Pages.Tabs.HomePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#101922">

	<Grid Padding="16">

		<!-- ### CONTENT ### -->
		<RefreshView
            IsVisible="{Binding HasAnyTrip}"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}">

			<Grid RowDefinitions="*,Auto">

				<!-- ================= CURRENT TRIP CARD ================= -->
				<Frame
                    Grid.Row="0"
                    CornerRadius="26"
                    Padding="18"
                    Margin="0,8"
                    HasShadow="False"
                    BackgroundColor="#1B2633"
                    BorderColor="#2A3646"
                    IsVisible="{Binding ShowCurrentSplash}">

					<Grid RowDefinitions="Auto,Auto,*"
                          RowSpacing="14">

						<!-- HEADER -->
						<Grid Grid.Row="0" ColumnDefinitions="*,Auto">

							<VerticalStackLayout Spacing="2">

								<Label
                                    Text="CURRENT TRIP"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#137fec"
                                    CharacterSpacing="2" />

								<Label
                                    Text="{Binding Current.Name}"
                                    FontSize="28"
									Padding="0,10"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    LineBreakMode="WordWrap" />

							</VerticalStackLayout>

							<!-- search circle placeholder -->
							<Frame

                                Grid.Column="1"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="2222"
                                BackgroundColor="#243244"
                                HasShadow="False"
                                HorizontalOptions="End"
                                VerticalOptions="Start" />
		

						</Grid>

						<!-- DATE + DESTINATIONS -->
						<VerticalStackLayout Grid.Row="1" Spacing="12" >

							<!-- DATE PILL -->
							<Frame
                                Padding="12,8"
								Margin="0,0,6,0"
                                CornerRadius="18"
                                BackgroundColor="#243244"
					            BorderColor="#101922"
                                HasShadow="False"
                                HorizontalOptions="Start">

								<Label
									Text="{Binding CurrentDateRangeText}"
									FontSize="11"
									FontAttributes="Bold"
									TextColor="White" />
								
							</Frame>

							<!-- DESTINATIONS -->
							<CollectionView
                                ItemsSource="{Binding Current.Destinations}"
                                ItemsLayout="HorizontalList"
                                HeightRequest="34"
                                SelectionMode="None">

								<CollectionView.ItemTemplate>
									<DataTemplate>
										<Frame
                                            Padding="12,8"
                                            Margin="0,0,6,0"
                                            CornerRadius="18"
                                            BackgroundColor="#2A3646"
                                            BorderColor="#3A4758"
                                            HasShadow="False">

											<Label
                                                Text="{Binding Name}"
                                                FontSize="11"
                                                TextColor="#E6EEF8" />
										</Frame>
									</DataTemplate>
								</CollectionView.ItemTemplate>
							</CollectionView>

						</VerticalStackLayout>

						<!-- QUICK NOTES PANEL -->
						<Frame
							Grid.Row="2"
							CornerRadius="18"
							BackgroundColor="#16202B"
							BorderColor="#2A3646"
							HasShadow="False"
							Padding="16"
							MinimumHeightRequest="120">

							<VerticalStackLayout Spacing="12">

								<!-- HEADER -->
								<HorizontalStackLayout Spacing="8">

									<!-- icon placeholder -->
									<BoxView
										WidthRequest="14"
										HeightRequest="14"
										Color="#137fec"
										VerticalOptions="Center" />

									<Label
										Text="QUICK NOTES"
										FontSize="11"
										FontAttributes="Bold"
										TextColor="#9FB3C8"
										CharacterSpacing="1.5"
										VerticalOptions="Center" />

								</HorizontalStackLayout>

								<!-- CONTENT PLACEHOLDER -->
								<Grid HeightRequest="70" />

							</VerticalStackLayout>

						</Frame>

					</Grid>
				</Frame>

				<!-- ================= NEXT TRIP FOLLOWER ================= -->
				<Frame
                    Grid.Row="1"
                    CornerRadius="20"
                    Padding="16"
                    Margin="0,8"
                    BackgroundColor="#1B2633"
                    BorderColor="#2A3646"
                    HasShadow="False"
                    IsVisible="{Binding ShowNextFollower}">
					
					
					<Grid ColumnDefinitions="Auto,*,Auto">

						<!-- LEFT (image placeholder) -->
						<VerticalStackLayout
							Grid.Column="0"
							Spacing="0"
							HorizontalOptions="Start"
							VerticalOptions="Center">

							<!-- kasnije možeš ubaciti sliku -->
							<Image
								Source="trip_placeholder.png"
								WidthRequest="40"
								HeightRequest="40"
								Aspect="AspectFill"/>

						</VerticalStackLayout>


						<!-- CENTER -->
						<VerticalStackLayout
							Grid.Column="1"
							Spacing="2"
							HorizontalOptions="Center"
							VerticalOptions="Center">

							<Label
								Text="NEXT ADVENTURE"
								FontSize="9"
								FontAttributes="Bold"
								TextColor="#7F93A8"
								CharacterSpacing="1.5"
								HorizontalTextAlignment="Center"/>

							<Label
								Text="{Binding Next.Name}"
								FontSize="16"
								FontAttributes="Bold"
								TextColor="White"
								HorizontalTextAlignment="Center"/>

						</VerticalStackLayout>


						<!-- RIGHT -->
						<VerticalStackLayout
							Grid.Column="2"
							Spacing="2"
							HorizontalOptions="End"
							VerticalOptions="Center">

							<Label
								Text="{Binding NextTripCountdownText}"
								FontSize="16"
								FontAttributes="Bold"
								TextColor="#137fec"
								HorizontalTextAlignment="End"/>

							<Label
								Text="DAYS TO GO"
								FontSize="9"
								FontAttributes="Bold"
								TextColor="#7F93A8"
								HorizontalTextAlignment="End"/>

						</VerticalStackLayout>

					</Grid>
				</Frame>

				<!-- ================= NEXT SPLASH ================= -->
				<Frame
                    Grid.RowSpan="2"
                    CornerRadius="28"
                    Padding="20"
                    BackgroundColor="#137fec"
                    HasShadow="False"
                    IsVisible="{Binding ShowNextSplash}">

					<Label
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="Medium"
                        TextColor="White"
                        Text="{Binding Next.Name}" />
				</Frame>

			</Grid>
		</RefreshView>

		<!-- EMPTY STATE -->
		<StackLayout
            IsVisible="{Binding IsEmpty}"
            HorizontalOptions="Center"
            VerticalOptions="Center">
		</StackLayout>

		<!-- LOADING -->
		<ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="White" />

	</Grid>
</ContentPage>
	

