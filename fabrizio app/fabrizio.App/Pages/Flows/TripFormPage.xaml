<ContentPage
	x:Class="fabrizio.App.Pages.Flows.TripFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	Shell.NavBarIsVisible="False"
	BackgroundColor="#101922">

		<Grid RowDefinitions="Auto,*,Auto">
			
			<!-- HEADER -->
			<Grid 
				Padding="16,12"
				ColumnDefinitions="40,*,40"
				BackgroundColor="#101922">

				<ImageButton
					Source="close.png"
					BackgroundColor="Transparent"
					HeightRequest="24"
					WidthRequest="24"
					Command="{Binding CancelCommand}" />

				<Label
					Grid.Column="1"
					Text="{Binding Title}"
					HorizontalOptions="Center"
					VerticalOptions="Center"
					FontSize="18"
					FontAttributes="Bold"
					TextColor="White"/>

				<ImageButton
					Grid.Column="2"
					Source="check.png"
					BackgroundColor="Transparent"
					HeightRequest="24"
					WidthRequest="24"
					HorizontalOptions="End"
					Command="{Binding SaveCommand}" />
			</Grid>
			

			<!-- CONTENT -->
			<ScrollView Grid.Row="1">

				<VerticalStackLayout
					Padding="16,24"
					Spacing="24">

			     	<!-- GENERAL INFORMATION -->
					<VerticalStackLayout Spacing="12">

					<Label
                        Text="General Information"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"/>

					<!-- Trip Name -->
					<VerticalStackLayout Spacing="4">
						<Label
                            Text="Trip Name"
                            FontSize="13"
                            TextColor="#9FB3C8"/>

						<Frame
                            Padding="12"
                            BackgroundColor="#1B2633"
                            BorderColor="#2A3646"
                            CornerRadius="12">

							<Entry
                                Text="{Binding Name}"
                                Placeholder="e.g. Summer in Dalmatia"
                                TextColor="White"
                                PlaceholderColor="#6B7C93"/>
						</Frame>
					</VerticalStackLayout>

					<!-- Dates -->
					<Grid ColumnDefinitions="*,*" ColumnSpacing="12">

						<VerticalStackLayout Spacing="4">

							<Label
                                Text="Start Date"
                                FontSize="13"
                                TextColor="#9FB3C8"/>

							<Frame
                                Padding="12"
                                BackgroundColor="#1B2633"
                                BorderColor="#2A3646"
                                CornerRadius="12">

								<DatePicker
                                    Date="{Binding StartDate}"
                                    TextColor="White"/>
							</Frame>

						</VerticalStackLayout>


						<VerticalStackLayout
							Grid.Column="1"
                            Spacing="4">

							<Label
                                Text="End Date"
                                FontSize="13"
                                TextColor="#9FB3C8"/>

							<Frame
                                Padding="12"
                                BackgroundColor="#1B2633"
                                BorderColor="#2A3646"
                                CornerRadius="12">

								<DatePicker
                                    Date="{Binding EndDate}"
                                    TextColor="White"/>
							</Frame>

						</VerticalStackLayout>

					</Grid>

				</VerticalStackLayout>


				<!-- DESTINATIONS -->
				<VerticalStackLayout Spacing="12">

					<Grid ColumnDefinitions="*,Auto">

						<Label
                            Text="Destinations"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White"/>

						<Button
                            Grid.Column="1"
                            Text="+ Add"
                            BackgroundColor="Transparent"
                            TextColor="#2E7DFF"
                            Command="{Binding AddDestinationCommand}"/>

					</Grid>


					<CollectionView
                        ItemsSource="{Binding Destinations}"
                        SelectionMode="None">

						<CollectionView.ItemTemplate>

							<DataTemplate>

								<Frame
                                    Padding="12"
                                    Margin="0,0,0,8"
                                    CornerRadius="12"
                                    BackgroundColor="#1B2633"
                                    BorderColor="#2A3646">

									<Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="12">

										<Image
                                            Source="location.png"
                                            WidthRequest="20"
                                            HeightRequest="20"
                                            VerticalOptions="Center"/>

										<Label
                                            Grid.Column="1"
                                            Text="{Binding Name}"
                                            VerticalOptions="Center"
                                            TextColor="White"/>

										<ImageButton
                                            Grid.Column="2"
                                            Source="trash.png"
                                            BackgroundColor="Transparent"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDestinationCommand}"
                                            CommandParameter="{Binding .}"/>

									</Grid>

								</Frame>

							</DataTemplate>

						</CollectionView.ItemTemplate>

					</CollectionView>

				</VerticalStackLayout>


				<!-- NOTES -->
				<VerticalStackLayout Spacing="4">

					<Label
                        Text="Notes"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"/>

					<Frame
                        Padding="12"
                        BackgroundColor="#1B2633"
                        BorderColor="#2A3646"
                        CornerRadius="12">

						<Editor
                            Text="{Binding Notes}"
                            AutoSize="TextChanges"
                            HeightRequest="120"
                            TextColor="White"
                            Placeholder="Tell us more about your plans..."/>

					</Frame>

				</VerticalStackLayout>

			</VerticalStackLayout>

		</ScrollView>


			<!-- FOOTER -->
			<VerticalStackLayout
				Grid.Row="2"
				Padding="16"
				Spacing="12"
				BackgroundColor="#101922">

			<Button
				Text="Save Trip"
                HeightRequest="56"
                CornerRadius="12"
                BackgroundColor="#2E7DFF"
                TextColor="White"
                FontAttributes="Bold"
                Command="{Binding SaveCommand}" />

			<Button
                Text="Cancel"
                HeightRequest="56"
                CornerRadius="12"
                BackgroundColor="Transparent"
                TextColor="#9FB3C8"
                Command="{Binding CancelCommand}" />

		</VerticalStackLayout>

	</Grid>

</ContentPage>