<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fabrizio.App.Pages.Flows.EditLanguagePage"
             Title="Select your language"
             BackgroundColor="#101922">

	<CollectionView
        ItemsSource="{Binding Languages}"
        SelectionMode="None"
        Margin="16">

		<CollectionView.ItemTemplate>
			<DataTemplate>
				<Grid Padding="14"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">

					<!-- Placeholder za buduću zastavu -->
					<BoxView WidthRequest="24"
                             HeightRequest="24"
                             Opacity="0" />

					<!-- Naziv jezika -->
					<Label Grid.Column="1"
                           Text="{Binding Name}"
                           TextColor="#94A3B8"
                           FontSize="16"
                           VerticalOptions="Center" />

					<!-- Tap gesture -->
					<Grid.GestureRecognizers>
						<TapGestureRecognizer
							Command="{Binding BindingContext.SelectLanguage, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
							CommandParameter="{Binding .}" />
					</Grid.GestureRecognizers>

				</Grid>
			</DataTemplate>
		</CollectionView.ItemTemplate>

	</CollectionView>

</ContentPage>