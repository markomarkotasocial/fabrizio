<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fabrizio.App.Pages.Flows.EditTimeZonePage"
			 x:Name="ThisPage"
             Title="Select your time zone"
             BackgroundColor="#101922">

	<CollectionView
        ItemsSource="{Binding TimeZones}"
        SelectionMode="None"
        Margin="16">

		<CollectionView.ItemTemplate>
			<DataTemplate>
				<Grid Padding="14"
                      ColumnDefinitions="*, Auto"
                      ColumnSpacing="12">

					<!-- Naziv valute -->
					<Label Grid.Column="0"
						   Text="{Binding DisplayName}"
						   TextColor="#94A3B8"
						   FontSize="16"
						   Padding="0,0,0,0"
						   VerticalOptions="Center" />

					<!-- ✅ CHECKMARK -->
					<Label Grid.Column="1"
                           Text="✓"
                           FontSize="16"
                           TextColor="#22C55E"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsSelected}" />

					<!-- Tap gesture -->
					<Grid.GestureRecognizers>
						<TapGestureRecognizer
                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectTimeZoneCommand}"
                            CommandParameter="{Binding .}" />
					</Grid.GestureRecognizers>

				</Grid>
			</DataTemplate>
		</CollectionView.ItemTemplate>

	</CollectionView>

</ContentPage>