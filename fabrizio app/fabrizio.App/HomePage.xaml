<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fabrizio.App.HomePage"
             BackgroundColor="White">

	<Grid RowDefinitions="*,Auto">

		<!-- Scrollable content -->
		<ScrollView Grid.Row="0">
			<VerticalStackLayout Padding="30" Spacing="20">
				<Label Text="Welcome to Home Page!" FontSize="24" TextColor="Black" />

				<Label Text="This part is scrollable..." TextColor="Gray"/>
				<BoxView HeightRequest="100" Color="DeepSkyBlue" CornerRadius="8" />
				<BoxView HeightRequest="100" Color="DeepSkyBlue" CornerRadius="8"/>
				<BoxView HeightRequest="100" Color="DeepSkyBlue" CornerRadius="8"/>
				<BoxView HeightRequest="100" Color="DeepSkyBlue" CornerRadius="8"/>
				<BoxView HeightRequest="100" Color="DeepSkyBlue" CornerRadius="8"/>
			</VerticalStackLayout>
		</ScrollView>

		<!-- Fixed bottom menu -->
		<StackLayout Grid.Row="1" Orientation="Horizontal"
                     BackgroundColor="DimGray"
                     Padding="10" Spacing="20"
                     HorizontalOptions="Fill" VerticalOptions="End">

			<Button Text="Home" FontSize="Small" HorizontalOptions="FillAndExpand" BackgroundColor="DimGray"/>
			<Button Text="Trips" FontSize="Small" HorizontalOptions="FillAndExpand" BackgroundColor="DimGray"/>
			<Button Text="Bookings" FontSize="Small" HorizontalOptions="FillAndExpand" BackgroundColor="DimGray"/>
			<Button Text="Notifications" FontSize="Small" HorizontalOptions="FillAndExpand" BackgroundColor="DimGray"/>
			<Button Text="Profile" FontSize="Small" HorizontalOptions="FillAndExpand" BackgroundColor="DimGray"/>

		</StackLayout>
	</Grid>
</ContentPage>
